# ── REQUIRED (only these 2 + the Redis database) ──────────────
AGENT_ADDRESS=NQ.. your Nimiq Pay wallet address ..
AGENT_KEY=any-long-random-password
# Database: in Vercel → Storage → Upstash Redis → Connect. It fills these in for you.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# ── OPTIONAL (add later) ──────────────────────────────────────
# Agent bonds: a Nimiq wallet YOU control (create one at wallet.nimiq.com, not Nimiq Pay).
# Once set, agents must deposit NIM here with the memo NIMPOINT-BOND-<AGENT ID> before they can take orders.
# BOND_ADDRESS=NQ..
# BOND_NETWORK=mainnet          # "testnet" only for a demo with test NIM
# TEAM_WALLETS=NQ.., NQ..       # your own wallets: their orders are marked "team" on /proof
# Lets you close reported orders (POST /api/admin). Also used for the Telegram setup link.
# ADMIN_KEY=any-long-random-password
# Test network: on by default, test orders are labelled and never counted. Set to "off" to refuse test wallets.
# NIMIQ_TESTNET_RPC_URL=https://rpc.testnet.nimiqwatch.com
# Leave NIMIQ_RPC_URL unset in production: it must point at a MAINNET node.
# NIMIQ_RPC_URL=https://rpc.nimiqwatch.com
# An agent who hasn't had the console open for this many hours is shown offline (default 12).
# AGENT_IDLE_HOURS=12
# AGENT_NAME=NimPoint Yaba
# AGENT_AREA=Yaba, Lagos
# For bank top-ups:
# AGENT_BANK_NAME=
# AGENT_BANK_ACCOUNT=
# AGENT_BANK_ACCOUNT_NAME=
# Telegram alerts:
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
# ADMIN_KEY=
# AGENT_TELEGRAM_CHAT_ID=
