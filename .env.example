# ── REQUIRED (only these 2 + the Redis database) ──────────────
AGENT_ADDRESS=NQ.. your Nimiq Pay wallet address ..
AGENT_KEY=any-long-random-password
# Database: in Vercel → Storage → Upstash Redis → Connect. It fills these in for you.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# ── OPTIONAL (add later) ──────────────────────────────────────
# AGENT_NAME=NimPoint Yaba
# AGENT_AREA=Yaba, Lagos
# For bank top-ups:
# AGENT_BANK_NAME=
# AGENT_BANK_ACCOUNT=
# AGENT_BANK_ACCOUNT_NAME=
# Telegram alerts:
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
# ADMIN_KEY=
# AGENT_TELEGRAM_CHAT_ID=
